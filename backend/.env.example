# Copy this file to `.env` and fill in your credentials.

APP_NAME=ResQMap AI Backend
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# OpenWeather (optional). Without a key the API returns simulated weather.
OPENWEATHER_API_KEY=PASTE_YOUR_OPENWEATHER_API_KEY
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# OpenAI-compatible LLM (optional). Without config the API uses templates.
LLM_API_KEY=PASTE_YOUR_LLM_API_KEY
LLM_BASE_URL=PASTE_YOUR_LLM_BASE_URL
LLM_MODEL=PASTE_YOUR_LLM_MODEL

# Reserved for a future routing provider (unused in the MVP).
ROUTING_API_KEY=

REQUEST_TIMEOUT_SECONDS=8

# Set true to force fully-offline labelled-simulated mode (no external calls).
OFFLINE_MODE=false
